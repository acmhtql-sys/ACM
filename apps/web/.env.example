# ==============================================================================
# ACM WEB FRONTEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Target: apps/web/.env
# ==============================================================================

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Request Timeout in Milliseconds (10000ms for localhost, 90000ms for Render Free)
VITE_API_TIMEOUT_MS=10000

# Security Gate: Set to true only in Staging Read-Only evaluation mode
VITE_STAGING_READ_ONLY=false

# Feature Flags
VITE_ENABLE_LOCATION_WRITES=true
VITE_ENABLE_STOCK_TRANSACTION_WRITES=true
VITE_ENABLE_STOCK_ADJUSTMENT=true
VITE_ENABLE_CAMERA_RETURN=false

