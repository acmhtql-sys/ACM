# ==============================================================================
# ACM API BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Target: apps/api/.env
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL 17)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acm_inventory?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acm_inventory_shadow?schema=public

# Authentication & Security
JWT_SECRET=super-secret-acm-jwt-token-key-change-in-production-2026
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Logging
LOG_LEVEL=debug

# Storage Provider (Cloudinary Media CDN)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=zua6n3a3
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Deployment Profile & Safety Gates
# Values: local_dev | gate_b | s2c_sandbox | cloud_staging | production
ACM_DEPLOYMENT_PROFILE=local_dev
ACM_RETURN_OPERATIONS_ENABLED=false
STAGING_READ_ONLY=false
ALLOW_STAGING_AUTH_LOGIN=false

