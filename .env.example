# ==============================================================================
# ACM SYSTEM ENVIRONMENT CONFIGURATION (ROOT TEMPLATE)
# ==============================================================================

# Backend (apps/api)
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL 17)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acm_inventory?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acm_inventory_shadow?schema=public

# Authentication & Security
JWT_SECRET=super-secret-acm-jwt-token-key-change-in-production-2026
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Logging
LOG_LEVEL=debug

# Storage Provider (Cloudinary Media CDN - Cloud: zua6n3a3)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=zua6n3a3
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Feature & Cutover Safety Gates
ACM_DEPLOYMENT_PROFILE=local_dev
ACM_RETURN_OPERATIONS_ENABLED=false
STAGING_READ_ONLY=false

# Frontend (apps/web)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_TIMEOUT_MS=10000
VITE_STAGING_READ_ONLY=false
VITE_ENABLE_LOCATION_WRITES=true
VITE_ENABLE_STOCK_TRANSACTION_WRITES=true
VITE_ENABLE_STOCK_ADJUSTMENT=true
VITE_ENABLE_CAMERA_RETURN=false
VITE_APP_TITLE="ACM – Components & Equipment Management System"
