# ==============================================================================
# ACM SYSTEM ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Backend (apps/api)
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acm_inventory?schema=public

# Authentication & Security
JWT_SECRET=super-secret-acm-jwt-token-key-change-in-production-2026
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Logging
LOG_LEVEL=debug

# Frontend (apps/web)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE="ACM – Components & Equipment Management System"
